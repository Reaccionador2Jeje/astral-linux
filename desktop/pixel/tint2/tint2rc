# ASTRAL PIXEL panel
panel_monitor = all
panel_position = bottom center horizontal
panel_size = 100% 34
panel_margin = 0 0
panel_padding = 6 3 6
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_layer = top
panel_items = P:T: taskbar

# Backgrounds
rounded = 0
border_width = 1
background_color = #d7dce5 100
border_color = #596579 100
background_id = 1

# Launcher and taskbar
taskbar_mode = single_desktop
taskbar_padding = 2 2 2
taskbar_background_id = 0
taskbar_active_background_id = 2
taskbar_name = 1
taskbar_name_font = Sans 9
taskbar_name_font_color = #18202c 100
taskbar_name_active_font_color = #101820 100
taskbar_name_active_background_id = 2
taskbar_sort_order = none
taskbar_width = 0
taskbar_height = 28
taskbar_padding = 4 2 4
taskbar_background_id = 0
taskbar_active_background_id = 2

# Active window button
rounded = 0
background_color = #b8c5d8 100
border_color = #53657c 100
background_id = 2

# Clock
time1_format = %H:%M
time1_font = Sans Bold 9
time1_font_color = #18202c 100
clock_padding = 8 0
clock_background_id = 0
clock_tooltip = %A, %d %B %Y
